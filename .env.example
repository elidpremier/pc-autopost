# PC AutoPost — variables optionnelles
# Extraction par IA via API compatible OpenAI — optionnelle.
# PC_AUTOPOST_LLM_API_KEY=gsk_...
# PC_AUTOPOST_LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
