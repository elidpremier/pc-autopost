# Détourage local recommandé.
# Démarrer avec : npm run install-rembg puis npm run start-rembg
BACKGROUND_REMOVAL_URL=http://127.0.0.1:7000
BACKGROUND_REMOVAL_MODEL=birefnet-general-lite
BACKGROUND_REMOVAL_TIMEOUT_MS=120000
